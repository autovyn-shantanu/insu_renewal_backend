{
  "swagger": "2.0",
  "info": {
    "title": "employee API",
    "version": "1.0.0",
    "description": ""
  },
  "host": "localhost:5000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "Enter your token with the prefix 'Bearer '"
    }
  },
  "paths": {
  "/employee/All": {
  "post": {
    "tags": [
      "Employee"
    ],
    "description": "Fetch active employee list and available locations. Optionally filter employees by branch/location.",
    "consumes": [
      "application/json"
    ],
    "parameters": [
      {
        "name": "compcode",
        "in": "header",
        "required": true,
        "type": "string",
        "description": "Company code"
      },
      {
        "name": "name",
        "in": "header",
        "required": false,
        "type": "string",
        "description": "Logged-in user name"
      },
      {
        "in": "body",
        "name": "body",
        "required": false,
        "schema": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string",
              "example": "1,2",
              "description": "Optional branch/location HOD codes for filtering employees"
            }
          }
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Employee data fetched successfully",
        "schema": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": true
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "example": "EMP0001"
                  },
                  "label": {
                    "type": "string",
                    "example": "EMP0001 John Doe"
                  }
                }
              }
            },
            "Location": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "example": "1"
                  },
                  "label": {
                    "type": "string",
                    "example": "Jaipur"
                  }
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Server Error",
        "schema": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean",
              "example": false
            },
            "message": {
              "type": "string",
              "example": "No data found"
            }
          }
        }
      }
    }
  }
