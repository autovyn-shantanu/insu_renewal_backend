    "/employee/generateCode": {
      "post": {
        "description": "Generate a new employee code based on selected branch and HR Region configuration.",
        "parameters": [
          {
            "name": "compcode",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Company Code"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "branch"
              ],
              "properties": {
                "branch": {
                  "type": "string",
                  "example": "1",
                  "description": "Selected branch code. Only a single branch is allowed."
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee code generated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "example": "MA0001"
                }
              }
            }
          },
          "201": {
            "description": "Multiple branches selected",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Please select a single branch before generating code."
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "New Employee Sequence not defined, kindly contact Auto-VYN to set employee code auto generate sequence!"
                }
              }
            }
          }
        }
      }
    }
