    "/employee/SmEmplMasters": {
      "post": {
        "description": "Get dropdown master data required for Mini Employee Form, including Employee List, Location List, and Employee Designation List.",
        "parameters": [
          {
            "name": "compcode",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Company Code"
          },
          {
            "name": "name",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Logged-in User Name"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "multi_loc12": {
                  "type": "string",
                  "example": "1,2,3",
                  "description": "Location codes used for employee filtering"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Master data fetched successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "EMPL": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "example": "Manish Sharma"
                          },
                          "value": {
                            "type": "string",
                            "example": "MA0001"
                          }
                        }
                      }
                    },
                    "LOCATION": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "example": "Jaipur"
                          },
                          "value": {
                            "type": "integer",
                            "example": 1
                          }
                        }
                      }
                    },
                    "EMPLOYEEDESIGNATION": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "example": "Software Developer"
                          },
                          "value": {
                            "type": "string",
                            "example": "Software Developer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
