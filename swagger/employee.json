    "/employee/savemini": {
      "post": {
        "description": "Create a new employee using Mini Employee Form. Employee code is auto-generated based on branch/HR Region configuration.",
        "parameters": [
          {
            "name": "compcode",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Company Code"
          },
          {
            "name": "name",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Logged-in User Name"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "EmpMst": {
                  "type": "object",
                  "required": [
                    "EMPFIRSTNAME",
                    "LOCATION",
                    "MOBILE_NO"
                  ],
                  "properties": {
                    "EMPCODE": {
                      "type": "string",
                      "example": "MA0001"
                    },
                    "MSPIN": {
                      "type": "string",
                      "example": "MS12345"
                    },
                    "EMPFIRSTNAME": {
                      "type": "string",
                      "example": "Manish"
                    },
                    "EMPLASTNAME": {
                      "type": "string",
                      "example": "Sharma"
                    },
                    "CORPORATEMAILID": {
                      "type": "string",
                      "example": "manish@company.com"
                    },
                    "LOCATION": {
                      "type": "string",
                      "example": "1"
                    },
                    "EMPLOYEEDESIGNATION": {
                      "type": "string",
                      "example": "Software Developer"
                    },
                    "Export_Type": {
                      "type": "integer",
                      "example": 1
                    },
                    "ServerId": {
                      "type": "integer",
                      "example": 1
                    },
                    "MOBILE_NO": {
                      "type": "string",
                      "example": "9876543210"
                    },
                    "Reporting_1": {
                      "type": "string",
                      "example": "MA0010"
                    },
                    "Reporting_2": {
                      "type": "string",
                      "example": "MA0005"
                    },
                    "Reporting_3": {
                      "type": "string",
                      "example": "MA0001"
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "Message": {
                  "type": "string",
                  "example": "Date saved"
                }
              }
            }
          },
          "500": {
            "description": "Validation or Server Error",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": false
                },
                "Message": {
                  "type": "string",
                  "example": "Employee already exists"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "Employee already exists",
                    "Employee Mobile Number already exists"
                  ]
                }
              }
            }
          }
        }
      }
    },
