{
  "swagger": "2.0",
  "info": {
    "title": "Admin API",
    "version": "1.0.0",
    "description": ""
  },
  "host": "localhost:5000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "Enter your token with the prefix 'Bearer '"
    }
  },
  "paths": {
    "/admin/All": {
      "post": {
        "tags": [
          "Admin"
        ],
        "description": "Fetch employee master list and available locations. Optionally filter employees by branch.",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "compcode",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Company Code"
          },
          {
            "name": "name",
            "in": "header",
            "required": false,
            "type": "string",
            "description": "User Name"
          },
          {
            "name": "body",
            "in": "body",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "branch": {
                  "type": "string",
                  "description": "Godown Code(s) for filtering employees. Example: '1' or '1,2,3'"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee list fetched successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "data": {
                  "type": "array",
                  "description": "Employee List",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "example": "0003",
                        "description": "Employee Code"
                      },
                      "label": {
                        "type": "string",
                        "example": "0003 MANISH SHARMA",
                        "description": "Employee Display Name"
                      }
                    }
                  }
                },
                "Location": {
                  "type": "array",
                  "description": "Location List",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "example": "1"
                      },
                      "label": {
                        "type": "string",
                        "example": "JAIPUR"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": false
                },
                "message": {
                  "type": "string",
                  "example": "No data found"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}