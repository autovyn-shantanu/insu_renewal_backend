{
  "swagger": "2.0",
  "info": {
    "title": "BodyShop API",
    "version": "1.0.0",
    "description": ""
  },
  "host": "localhost:5000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "Enter your token with the prefix 'Bearer '"
    }
  },
  "paths": {
    "/BodyShop/BodyShopReports": {
      "post": {
        "description": "",
        "parameters": [
          {
            "name": "compcode",
            "in": "header",
            "type": "string"
          },
          {
            "name": "name",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/BodyShop/BodyShopOrderCheck": {
      "post": {
        "description": "",
        "parameters": [
          {
            "name": "compcode",
            "in": "header",
            "type": "string"
          },
          {
            "name": "name",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/BodyShop/BodyShopDownload": {
      "get": {
        "description": "",
        "produces": [
          "attachment; filename=\"Body_shop_holdUpReport ${new Date().toDateString()}.xlsx\""
        ],
        "parameters": [
          {
            "name": "compcode",
            "in": "header",
            "type": "string"
          },
          {
            "name": "name",
            "in": "header",
            "type": "string"
          },
          {
            "name": "compcode",
            "in": "query",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/BodyShop/GetBtachAndCount": {
      "post": {
        "description": "",
        "parameters": [
          {
            "name": "compcode",
            "in": "header",
            "type": "string"
          },
          {
            "name": "name",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}